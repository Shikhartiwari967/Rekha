# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit real passwords.
# Start the backend with:  python -m uvicorn app:app --port 8000 --env-file .env

REKHA_RED_PASSWORD=change-me-red
REKHA_BLUE_PASSWORD=change-me-blue
REKHA_ADMIN_PASSWORD=change-me-admin

# Signs login tokens. Keep it set so restarts don't log everyone out. Any long random string.
REKHA_SECRET=change-me-to-a-long-random-string

# Optional
# REKHA_DB=data/rekha.db
# REKHA_MODEL=auto            # auto | ollama | mock
# REKHA_OLLAMA_MODEL=qwen2.5:0.5b

# Ed25519 ledger signing key (hex seed). Keeps the key out of the database.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
REKHA_SIGNING_KEY=

# Stage-only Tamper/Reset buttons: 1 = on (local demo), 0 = off (public link / production)
# REKHA_DEMO=1
# Browser origins allowed to call the API directly
# REKHA_CORS_ORIGINS=http://localhost:5173
